{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=wholesale;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "WholesaleAPI",
    "Audience": "WholesaleApp",
    "Key": "CHANGE-ME-to-a-long-random-secret-at-least-32-chars",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 30,
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15
  },
  "Cors": {
    "Origins": [ "http://localhost:4200" ]
  },
  "EnableSwagger": false,
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": { "path": "logs/wholesale-.log", "rollingInterval": "Day", "retainedFileCountLimit": 30 }
      }
    ]
  },
  "AllowedHosts": "*"
}
